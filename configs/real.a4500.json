{
  "mode": "real",
  "backend": "transformers",
  "manifest_path": "data/videomme_a4500/manifest.json",
  "pilot": "both",
  "seed": 42,
  "seed_torch": true,
  "deterministic": true,
  "device": "cuda:0",
  "model_dtype": "bfloat16",
  "attention_implementation": "sdpa",
  "encoder_model": "openai/clip-vit-base-patch32",
  "encoder_revision": "main",
  "vlm_model": "Qwen/Qwen3.5-4B",
  "vlm_revision": "main",
  "candidate_fps": 2.0,
  "max_candidate_frames": 8192,
  "frame_height": 224,
  "frame_width": 224,
  "encoder_batch_size": 8,
  "detector": "D2",
  "boundary_threshold": 0.15,
  "window_size": 3,
  "min_segment_frames": 2,
  "max_segments": 128,
  "allocation_temperature": 1.0,
  "frame_budget": 16,
  "vlm_min_pixels": 102400,
  "vlm_max_pixels": 102400,
  "qa_length_normalize": true,
  "bootstrap_samples": 5000,
  "output_dir": "outputs/a4500",
  "cache_dir": ".cache/event_caption_a4500"
}
