{
  "mode": "real",
  "backend": "transformers",
  "manifest_path": "examples/manifest.example.json",
  "pilot": "both",
  "seed": 42,
  "seed_torch": true,
  "deterministic": true,
  "device": "cuda",
  "model_dtype": "bfloat16",
  "attention_implementation": "sdpa",
  "encoder_model": "openai/clip-vit-base-patch32",
  "encoder_revision": "main",
  "vlm_model": "Qwen/Qwen3.5-4B",
  "vlm_revision": "main",
  "candidate_fps": 2.0,
  "frame_height": 224,
  "frame_width": 224,
  "encoder_batch_size": 4,
  "detector": "D2",
  "frame_budget": 16,
  "caption_max_frames": 4,
  "caption_max_new_tokens": 80,
  "vlm_min_pixels": 16384,
  "vlm_max_pixels": 50176,
  "text_weight": 0.5,
  "output_dir": "outputs/real_rtx3060",
  "cache_dir": ".cache/event_caption_rtx3060"
}
